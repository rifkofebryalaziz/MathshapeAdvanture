  m_Script: {fileID: 11500000, guid: 5bdc2a6cfd97bfc4e943a32b92ec3317, type: 3}
  m_Name: 3Question_13
  m_EditorClassIdentifier: 
  question: Sebuah trapesium memiliki panjang sisi sejajar 10 cm dan 6 cm, serta
    tinggi 4 cm. Luasnya adalah
  optionA: "24 cm\xB2"
  optionB: "32 cm\xB2"
  optionC: "40 cm\xB2"
  optionD: "36 cm\xB2"
  correctAnswerIndex: 1
  explanation: "Luas = \xBD \xD7 (jumlah sisi sejajar) \xD7 tinggi = \xBD \xD7 (10+6)
    \xD7 4 = 32 cm\xB2"
